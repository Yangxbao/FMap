    { "tool": "claude-code", "kind": "signal", "os": "*", "pattern": "CLAUDE.local.md", "location": "project-root", "confidence": "likely", "weight": 0.9, "kind_tag": "project", "risk_level": "safe", "doc_url": "https://code.claude.com/docs/en/claude-directory", "source": "官方文档", "evidence": "Claude Code 本地版项目指令文件" },


    { "tool": "codex", "kind": "signal", "os": "*", "pattern": "AGENTS.md", "location": "project-root", "confidence": "possible", "weight": 0.5, "kind_tag": "project", "risk_level": "safe", "doc_url": "https://agents.md", "source": "AGENTS.md 开放约定（多工具共用，非 Codex 专属）", "evidence": "AGENTS.md 为跨工具开放约定，仅作为弱信号，不单独构成 Codex 归属" },


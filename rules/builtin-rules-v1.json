    { "tool": "cursor", "kind": "signal", "os": "*", "pattern": ".cursorignore", "location": "project-root", "confidence": "likely", "weight": 0.8, "kind_tag": "project", "risk_level": "safe", "doc_url": "https://cursor.com/docs", "source": "Cursor 官方文档", "evidence": "Cursor 索引忽略文件" },


    { "tool": "cursor", "kind": "dir", "os": "win", "pattern": "AppData/Roaming/Cursor", "confidence": "verified", "kind_tag": "config", "risk_level": "caution", "doc_url": "https://cursor.com/docs", "source": "VSCode-fork 惯例 + 论坛实证（state.vscdb 可达 50-100GB）", "evidence": "Cursor Chromium 用户数据目录" },
